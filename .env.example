# Copy to .env and fill in. Never commit .env.

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Number of proxy hops in front of the app (e.g. 1 behind a load balancer).
# Needed for correct per-IP rate limiting. Leave empty when not behind a proxy.
TRUST_PROXY=
# Origin of the web app. Used for share links (/q/:slug), the payment return
# page (/payment/verify?reference=) and password-reset links (/reset-password?token=).
# The site's public address, used in every link the API sends (team games, shared quizzes,
# payments, password reset). One address, e.g. https://pazzell.com in production.
FRONTEND_URL=http://localhost:3000

# --- Data stores -------------------------------------------------------------
DB_URI=mongodb://127.0.0.1:27017/pazzell
REDIS_URL=redis://127.0.0.1:6379

# --- Auth --------------------------------------------------------------------
ACCESS_TOKEN=change-me-long-random-string
REFRESH_TOKEN=change-me-another-long-random-string
ACTIVATION_SECRET=change-me-a-third-long-random-string
# Hours for the access token, days for the refresh token (or strings like "24h" / "7d")
ACCESS_TOKEN_EXPIRE=24
REFRESH_TOKEN_EXPIRE=7

# --- Payment gateway (Paystack) ----------------------------------------------
# Used for Pro and campaign payments.
# Webhook URL to register with Paystack:  {API_ORIGIN}/api/v1/payments/webhook/paystack
PAYSTACK_SECRET_KEY=

# --- Prices and game settings (defaults; an admin can override each at /admin/config)
# Currency the gateway charges in. Amounts are in major units of this currency.
# The gateway (Paystack) charges in naira: 1,500 NGN for Pro and 15,000 NGN for a campaign.
PAYMENT_CURRENCY=NGN
PRO_PRICE_AMOUNT=1500
PRO_DURATION_DAYS=30
CAMPAIGN_PRICE_AMOUNT=15000
CAMPAIGN_DURATION_DAYS=30
# Non-campaign trivias a freemium player completes before a campaign is required
CAMPAIGN_INTERRUPTION_THRESHOLD=10
# Share of a trivia session's cards that are image cards (the rest are definitions)
TRIVIA_IMAGE_PERCENT=70
# Contact (email or URL) sent to Wikimedia with image-import requests, as their API policy asks
WIKIMEDIA_CONTACT=
# --- AI (trivia from a document, from a description, and AI generated trivia) ---
# Which AI writes the cards: claude | openai | gemini. Leave empty to use the first of
# those whose API key is set. With no key, the AI features answer 503 AI_NOT_CONFIGURED
# and the rest of the app is unaffected.
AI_PROVIDER=
# Each provider has a "fast" model (cards from a document, checked against its text) and a
# "strong" model (cards from a topic or a description, and the second check of them).
# Leave a model empty for its default.
# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Fast model; default claude-haiku-4-5-20251001
ANTHROPIC_MODEL=
# Strong model; default claude-opus-5-5
ANTHROPIC_TOPIC_MODEL=
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Fast model; default gpt-5-mini
OPENAI_MODEL=
# Strong model; default gpt-5
OPENAI_TOPIC_MODEL=
# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Fast model; default gemini-2.5-flash
GEMINI_MODEL=
# Strong model; default gemini-2.5-pro
GEMINI_TOPIC_MODEL=
# Documents a player may turn into trivia per day
QUIZ_GENERATE_DAILY_LIMIT_FREE=3
QUIZ_GENERATE_DAILY_LIMIT_PRO=20
# AI generated trivias a Pro player may create per day
AI_TRIVIA_DAILY_LIMIT=10
# Network grace added to each question deadline before a submit counts as late (ms)
GAME_SUBMIT_GRACE_MS=1000

# --- Image storage -----------------------------------------------------------
# firebase (default) | aws | memory (tests / offline only, nothing is persisted)
STORAGE_PROVIDER=aws
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Optional CDN / custom domain in front of the bucket
AWS_S3_PUBLIC_BASE_URL=

# --- Google sign-in ----------------------------------------------------------
# The Google OAuth web client id (same as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# /auth/google only accepts Google tokens issued to it. Comma separate several ids.
GOOGLE_CLIENT_ID=

# --- Firebase service account ------------------------------------------------
# Required for Firebase idToken sign-in, and for storage when STORAGE_PROVIDER=firebase.
# The app boots without these.
TYPE=service_account
PROJECT_ID=
PRIVATE_KEY_ID=
PRIVATE_KEY=
CLIENT_EMAIL=
CLIENT_ID=
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_CERT_URL=
UNIVERSE_DOMAIN=googleapis.com
FIREBASE_STORAGE_BUCKET=

# --- Email -------------------------------------------------------------------
# gmail (default, SMTP) | twilio / sendgrid | aws (SES)
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=
SMTP_PASSWORD=
SENDGRID_API_KEY=
TWILIO_SMTP_HOST=smtp.sendgrid.net
TWILIO_SMTP_PORT=587
TWILIO_SMTP_USER=apikey
TWILIO_SMTP_PASSWORD=
TWILIO_SMTP_FROM=
AWS_SES_FROM_EMAIL=

# --- Seed script (npm run seed) ----------------------------------------------
SEED_ADMIN_EMAIL=admin@pazzell.local
# Leave empty to have a random password generated and printed once
SEED_ADMIN_PASSWORD=
SEED_BRAND_EMAIL=brand@pazzell.local
SEED_BRAND_PASSWORD=
# Must be "yes" to seed when NODE_ENV=production
SEED_CONFIRM=
